# AuraCli cloud-runtime study profile.
# Copy to .env and fill only the providers you explicitly want to exercise.
# Never commit the populated .env file.

AURA_PROFILE=rea-study
AURA_HOME=.aura/rea-study
AURA_PROJECT_ROOT=/Users/macbookpro/Desktop/Projetos/AuraCli
AURA_USE_ADK_BRIDGE=true
LITELLM_LOCAL_MODEL_COST_MAP=True

# Accessibility is opt-in. These settings never launch a device or reader.
# AURA_ACCESSIBLE=false
# AURA_ACCESSIBILITY_DEVICE=auto
# AURA_SCREEN_READER=

# The model identifier selects its provider (for example `gpt-4o-mini` or
# `gemini/gemini-2.5-flash`). Use the CLI `--model` for per-scenario isolation.
AURA__DEFAULT_MODEL=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
OPENROUTER_API_KEY=
NVIDIA_API_KEY=
CEREBRAS_API_KEY=
GROQ_API_KEY=

# Optional local MCP smoke test.
AURA_MCP_TOKEN=
