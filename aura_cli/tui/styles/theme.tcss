/* =============================================================================
 * Nebula TUI Theme - Aura CLI
 * 
 * A modern, elegant theme for the Aura CLI interface.
 * Following Textual CSS best practices and semantic variable naming.
 * 
 * Color Palette: Tokyo Night inspired with cosmic nebula aesthetics
 * =============================================================================
 */

/* CSS VARIABLES - Spacing System
   Define CSS variables using $var-name: value syntax for Textual
   ============================================================================= */
$spacing-0: 0;
$spacing-1: 1;
$spacing-2: 2;
$spacing-3: 3;
$spacing-4: 4;
$spacing-5: 5;
$spacing-6: 6;
$spacing-7: 7;
$spacing-8: 8;
$bubble-indent: 8;

/* CSS VARIABLES - Theme Color System (Nebula Dark defaults)
   ============================================================================= */
$theme-background: #111111;
$theme-background-secondary: #181818;
$theme-background-tertiary: #0b0b0b;
$theme-foreground: #e7e7e7;
$theme-foreground-muted: #8f8f8f;
$theme-primary: #8fb4ff;
$theme-primary-muted: #6f8fc8;
$theme-secondary: #b9a0ff;
$theme-secondary-muted: #8f79c6;
$theme-success: #10b981;
$theme-warning: #f59e0b;
$theme-error: #ef4444;
$theme-info: #3b82f6;
$theme-border: #333333;
$theme-border-active: #8fb4ff;
$theme-surface: #1b1b1b;
$theme-surface-hover: #252525;
$theme-code-background: #0f0f23;
$theme-code-keyword: #c678dd;
$theme-code-string: #98c379;
$theme-code-number: #d19a66;
$theme-code-comment: #5c6370;
$theme-code-function: #61afef;
$theme-chat-user: #3b82f6;
$theme-chat-assistant: #10b981;
$theme-chat-system: #f59e0b;
$theme-diff-add-bg: #1e3a1e;
$theme-diff-add-fg: #51cf66;
$theme-diff-remove-bg: #3a1e1e;
$theme-diff-remove-fg: #ff6b6b;
$theme-task-border: #f59e0b;
$theme-task-active: #fbbf24;
$theme-task-done: #10b981;
$theme-thought-fg: #94a3b8;
$theme-tree-line: #475569;

/* =============================================================================
   GLOBAL SCROLLBAR STYLING
   ============================================================================= */

* {
    scrollbar-background: $theme-surface;
    scrollbar-background-hover: $theme-surface;
    scrollbar-background-active: $theme-surface-hover;
    scrollbar-corner-color: $theme-surface;
    scrollbar-color: $theme-border;
    scrollbar-color-hover: $theme-primary;
    scrollbar-color-active: $theme-primary-muted;
    scrollbar-size: $spacing-1 $spacing-1;
}

/* =============================================================================
   SCREEN - Base Layout
   ============================================================================= */

Screen {
    background: $theme-background;
    color: $theme-foreground;
}

Screen:inline {
    height: auto;
}

/* =============================================================================
   MAIN GRID LAYOUT
   ============================================================================= */

.panel-container {
    border: none;
    padding: $spacing-1;
    background: $theme-surface;
}

.panel-title {
    background: transparent;
    color: $theme-foreground-muted;
    text-style: bold;
    text-align: left;
    padding: $spacing-0 $spacing-1;
    border-bottom: none;
    content-align: left middle;
}

#left_panel {
    display: none;
    border-right: solid $theme-border;
}

#left_panel.drawer-visible,
#right_panel.drawer-visible {
    background: $theme-surface;
}

#center_panel {
    border-left: solid $theme-border;
    border-right: solid $theme-border;
}

#right_panel {
    display: none;
    border-left: solid $theme-border;
}

#main_grid.drawer-overlay #left_panel.drawer-visible,
#main_grid.drawer-overlay #right_panel.drawer-visible {
    padding: $spacing-1;
    background: $theme-surface;
    border: round $theme-border;
}

/* =============================================================================
   LEFT PANEL - Sidebar
   ============================================================================= */

#left_panel_content {
    padding: $spacing-1;
    width: 100%;
    overflow-y: auto;
    background: $theme-surface;
}

.status-header {
    text-align: center;
    color: $theme-primary-muted;
    text-style: bold;
    padding: $spacing-1 $spacing-0;
    border-bottom: solid $theme-border;
    margin-bottom: $spacing-1;
}

.task-tree {
    margin-top: $spacing-1;
    background: transparent;
    color: $theme-foreground;
}

.directory-tree {
    height: 1fr;
    padding: $spacing-1;
    overflow-y: auto;
    background: $theme-background;
}

/* --- Metrics Panel --- */
MetricsPanel {
    width: 100%;
    height: auto;
    padding: $spacing-0;
    margin-bottom: $spacing-1;
}

#metrics_display {
    width: 100%;
    height: auto;
    padding: $spacing-0 $spacing-1;
}

/* =============================================================================
   CENTER PANEL - Main Content
   ============================================================================= */

Vertical#main_content {
    layout: vertical;
    background: $theme-background;
    height: 100%;
    min-width: 40;
}

/* --- Chat Log --- */
AuraChatLog {
    background: $theme-background;
}

AuraChatLog .chat-divider {
    text-align: center;
    color: $theme-foreground-muted;
    margin: $spacing-1 $spacing-0;
    text-style: dim;
}

/* =============================================================================
   MESSAGE BUBBLES
   ============================================================================= */

MessageBubble {
    width: 100%;
    max-width: 100%;
    height: auto;
    margin: 0 0 1 0;
    padding: 0 $spacing-1;
    border: none;
    background: transparent;
}

MessageBubble.message-user {
    margin-left: 0;
    padding: $spacing-1 $spacing-2;
    border-left: wide $theme-border-active;
    background: $theme-surface;
}

MessageBubble.message-assistant {
    margin-right: 0;
    padding: 0 $spacing-1;
    border: none;
    background: transparent;
}

MessageBubble.message-system {
    margin: $spacing-0 $spacing-2;
    border: none;
    background: transparent;
    text-style: dim;
}

MessageBubble.message-error {
    border: round $theme-error;
    background: $theme-error 15%;
}

MessageBubble.message-success {
    border: round $theme-success;
    background: $theme-success 15%;
}

MessageBubble.message-tool {
    border: round $theme-warning;
    background: $theme-warning 15%;
}

MessageBubble.message-thinking,
MessageBubble.message-tool {
    margin: 0 0 1 0;
    padding: 0 $spacing-1;
    text-style: dim;
    border: none;
    background: transparent;
}

MessageBubble.message-streaming {
    border-left: wide $theme-primary;
    background: $theme-primary 5%;
}

MessageBubble .message-header {
    width: 100%;
    height: auto;
    margin-bottom: $spacing-0;
}

MessageBubble .message-sender {
    text-style: bold;
    color: $theme-primary-muted;
}

MessageBubble .message-user-title {
    width: 1fr;
    color: $theme-foreground;
}

MessageBubble .message-thinking-title,
MessageBubble .message-tool-title {
    color: $theme-foreground-muted;
}

MessageBubble .message-thinking-content {
    color: $theme-thought-fg;
    padding-left: $spacing-1;
}

MessageBubble .message-streaming-indicator {
    color: $theme-primary;
    text-style: bold;
}

MessageBubble .message-timestamp {
    dock: right;
}

MessageBubble.message-user .message-sender {
    color: $theme-primary;
    text-align: right;
}

MessageBubble.message-assistant .message-sender {
    color: $theme-primary-muted;
}

MessageBubble.message-error .message-sender {
    color: $theme-error;
}

MessageBubble.message-success .message-sender {
    color: $theme-success;
}

MessageBubble.message-tool .message-sender {
    color: $theme-warning;
}

MessageBubble .message-timestamp {
    color: $theme-foreground-muted;
    text-style: dim;
    margin: $spacing-0 $spacing-1;
}

#main_grid.density-compact MessageBubble {
    margin-bottom: $spacing-0;
    padding: $spacing-0 $spacing-1;
}

MessageBubble .message-body {
    width: 100%;
    padding: $spacing-0;
    color: $theme-foreground;
}

MessageBubble .message-footer {
    margin-top: $spacing-0;
    padding-top: $spacing-0;
    border-top: none;
    color: $theme-foreground-muted;
    text-style: dim;
}

MessageBubble .message-reactions {
    margin-top: $spacing-1;
}

MessageBubble .message-reaction {
    background: $theme-surface-hover;
    padding: $spacing-0 $spacing-1;
    margin: $spacing-0 $spacing-1;
    border: round $theme-border;
}

/* =============================================================================
   INPUT BAR
   ============================================================================= */

AuraInputBar {
    background: $theme-background;
}

AuraInputBar > Vertical {
    height: auto;
}

AuraInputBar .command-suggestions {
    dock: bottom;
    width: 100%;
    max-height: 6;
    height: auto;
    background: $theme-surface;
    border: round $theme-border;
    margin-bottom: $spacing-1;
}

AuraInputBar .command-suggestions.-hidden {
    display: none;
}

AuraInputBar OptionList {
    background: $theme-surface;
    border: none;
}

Input {
    border: round $theme-border;
    background: $theme-background;
    color: $theme-foreground;
    padding: $spacing-0 $spacing-1;
}

Input:focus {
    border: round $theme-primary-muted;
    background: $theme-background;
}

Input.-invalid {
    border: round $theme-error;
}

/* =============================================================================
   FOOTER
   ============================================================================= */

AuraFooter {
    dock: bottom;
    height: 1;
    background: $theme-background;
    padding: $spacing-0 $spacing-2;
}

AuraFooter #footer-icon {
    color: $theme-primary;
    text-style: bold;
    margin-right: $spacing-1;
}

AuraFooter #footer-mode {
    width: auto;
    background: transparent;
    color: $theme-foreground-muted;
    padding: $spacing-0;
    text-style: bold;
}

AuraFooter #footer-mode.footer-mode-insert {
    background: transparent;
    color: $theme-primary-muted;
}

AuraFooter #footer-mode.footer-mode-agi {
    background: transparent;
    color: $theme-secondary;
}

AuraFooter #footer-mode.footer-mode-ops {
    background: transparent;
    color: $theme-warning;
}

AuraFooter .footer-keybindings {
    width: auto;
    margin: $spacing-0 $spacing-1;
}

AuraFooter .footer-keybinding {
    color: $theme-foreground-muted;
    margin-right: $spacing-2;
}

AuraFooter .footer-agent {
    color: $theme-secondary;
    margin-left: $spacing-1;
}

AuraFooter .footer-model {
    color: $theme-foreground-muted;
    text-style: dim;
}

AuraFooter .footer-key {
    color: $theme-primary-muted;
    text-style: bold;
}

AuraFooter .footer-action {
    color: $theme-foreground-muted;
}

AuraFooter .footer-separator {
    margin: $spacing-0 $spacing-1;
}

AuraFooter .footer-status {
    color: $theme-foreground-muted;
    text-style: italic dim;
}
AuraFooter .footer-external-tool {
    color: $theme-secondary;
    text-style: bold;
    width: auto;
    max-width: 32;
    overflow: hidden;
}
AuraFooter .footer-external-tool.external-tool-failed {
    color: $theme-error;
}
AuraFooter .footer-external-tool.external-tool-interrupted {
    color: $theme-warning;
}
AuraFooter .footer-external-tool.external-tool-completed {
    color: $theme-success;
}

AuraKeyHint {
    width: auto;
    height: 1;
}

AuraKeyHint .key {
    color: $theme-primary-muted;
    text-style: bold;
}

AuraKeyHint .action {
    color: $theme-foreground-muted;
}

/* =============================================================================
   LOADING INDICATORS
   ============================================================================= */

AuraLoadingIndicator {
    width: auto;
    height: 1;
    padding: $spacing-0 $spacing-1;
}

AuraLoadingIndicator.-hidden {
    display: none;
}

AuraLoadingIndicator .spinner {
    color: $theme-primary;
    text-style: bold;
    margin-right: $spacing-1;
}

AuraLoadingIndicator .message {
    color: $theme-primary-muted;
}

AuraLoadingIndicator .dots {
    color: $theme-foreground-muted;
    text-style: dim;
}

/* --- Progress Bar --- */
AuraProgressBar {
    width: 100%;
    height: 1;
    padding: $spacing-0 $spacing-1;
}

AuraProgressBar .progress-label {
    color: $theme-foreground-muted;
    margin-right: $spacing-1;
}

AuraProgressBar .progress-bar-container {
    width: 30;
    height: 1;
    border: solid $theme-border;
}

AuraProgressBar .progress-bar-fill {
    background: $theme-primary;
    height: 1;
}

AuraProgressBar .progress-bar-fill.complete {
    background: $theme-success;
}

AuraProgressBar .progress-percentage {
    margin-left: $spacing-1;
    color: $theme-foreground-muted;
}

AuraProgressBar .progress-percentage.complete {
    color: $theme-success;
    text-style: bold;
}

/* =============================================================================
   TOAST NOTIFICATIONS
   ============================================================================= */

AuraToastContainer {
    dock: top;
    layer: notification;
    align: right top;
    width: auto;
    height: auto;
    offset: -2 2;
}

AuraToast {
    width: 60;
    height: auto;
    padding: $spacing-1;
    border: round $theme-border;
    background: $theme-surface;
    margin: $spacing-0 $spacing-0 $spacing-1 $spacing-0;
}

AuraToast.toast-success {
    border-left: wide $theme-success;
    background: $theme-success 10%;
}

AuraToast.toast-error {
    border-left: wide $theme-error;
    background: $theme-error 10%;
}

AuraToast.toast-warning {
    border-left: wide $theme-warning;
    background: $theme-warning 10%;
}

AuraToast.toast-info {
    border-left: wide $theme-primary;
    background: $theme-primary 10%;
}

AuraToast .toast-icon {
    margin-right: $spacing-1;
    text-style: bold;
}

AuraToast.toast-success .toast-icon {
    color: $theme-success;
}

AuraToast.toast-error .toast-icon {
    color: $theme-error;
}

AuraToast.toast-warning .toast-icon {
    color: $theme-warning;
}

AuraToast.toast-info .toast-icon {
    color: $theme-primary;
}

AuraToast .toast-title {
    text-style: bold;
    margin-bottom: $spacing-1;
}

AuraToast .toast-message {
    color: $theme-foreground;
}

/* Built-in Toast styling */
Toast {
    width: auto;
    background: $theme-surface;
    color: $theme-foreground;
    border-left: wide $theme-primary;
    padding: $spacing-0 $spacing-1;
    margin: $spacing-0 $spacing-0 $spacing-1 $spacing-0;
}

Toast.-information {
    border-left: wide $theme-primary;
}

Toast.-warning {
    border-left: wide $theme-warning;
}

Toast.-error {
    border-left: wide $theme-error;
}

Toast .toast--title {
    color: $theme-primary;
    text-style: bold;
}

/* =============================================================================
   RIGHT PANEL - Tabbed Content
   ============================================================================= */

#right_panel TabbedContent {
    height: 1fr;
    width: 100%;
    background: $theme-surface;
}

TabbedContent {
    height: 1fr;
}

TabbedContent > Tabs {
    background: transparent;
    border-bottom: solid $theme-border;
}

Tabs {
    background: transparent;
}

Tab {
    padding: $spacing-0 $spacing-1;
    color: $theme-foreground-muted;
    background: transparent;
}

Tab:hover {
    color: $theme-foreground;
    background: $theme-surface-hover;
}

Tab.-active {
    color: $theme-primary-muted;
    text-style: bold;
    background: transparent;
}

Underline {
    background: $theme-primary-muted;
}

TabPane {
    padding: $spacing-0 $spacing-1;
    overflow-y: auto;
    background: transparent;
}

/* =============================================================================
   EVENT STREAM PANEL
   ============================================================================= */

EventStreamPanel {
    width: 100%;
    height: 100%;
    padding: $spacing-0 $spacing-1;
    overflow-y: scroll;
    background: transparent;
}

EventStreamPanel .event-entry {
    margin-bottom: $spacing-0;
    padding: $spacing-0 $spacing-1;
    border-left: solid $theme-border;
    background: transparent;
}

EventStreamPanel .event-timestamp {
    color: $theme-foreground-muted;
    text-style: dim;
    margin-right: $spacing-1;
}

EventStreamPanel .event-task-start {
    border-left: solid $theme-primary;
}

EventStreamPanel .event-task-update {
    border-left: solid $theme-primary-muted;
}

EventStreamPanel .event-task-complete {
    border-left: solid $theme-success;
}

EventStreamPanel .event-task-failed {
    border-left: solid $theme-error;
}

EventStreamPanel .event-tool-executing {
    border-left: solid $theme-warning;
}

EventStreamPanel .event-tool-result {
    border-left: solid $theme-success;
}

EventStreamPanel .event-tool-error {
    border-left: solid $theme-error;
}

EventStreamPanel .event-capability-evaluation {
    border-left: solid $theme-primary-muted;
}

EventStreamPanel .event-capability-confirmation {
    border-left: solid $theme-warning;
}

EventStreamPanel .event-capability-blocked {
    border-left: solid $theme-error;
}

EventStreamPanel .event-capability-commit {
    border-left: solid $theme-success;
}

EventStreamPanel .event-chat-message {
    border-left: solid $theme-primary;
}

EventStreamPanel .event-type-label {
    text-style: bold;
    margin-right: $spacing-1;
}

EventStreamPanel .event-content {
    color: $theme-foreground;
}

/* =============================================================================
   CODE ANALYSIS PANEL
   ============================================================================= */

CodeAnalysisPanel {
    height: 100%;
    width: 100%;
    padding: $spacing-1;
    overflow-y: auto;
}

CodeAnalysisPanel .panel-header {
    text-align: left;
    color: $theme-primary-muted;
    text-style: bold;
    padding-bottom: $spacing-1;
    border-bottom: solid $theme-border;
}

#code_viewer_container {
    height: 50%;
    min-height: 10;
    overflow-y: scroll;
    border: round $theme-border;
    margin-bottom: $spacing-1;
}

#code_viewer {
    width: 100%;
    height: auto;
    padding: $spacing-1;
    background: $theme-background;
}

#issues_header {
    color: $theme-warning;
    margin-top: $spacing-1;
    text-style: bold;
}

#issues_table {
    height: auto;
    max-height: 30%;
    margin: $spacing-1 $spacing-0;
}

/* =============================================================================
   TREE WIDGET
   ============================================================================= */

Tree {
    background: transparent;
    color: $theme-foreground;
    padding: $spacing-0;
    scrollbar-gutter: stable;
}

Tree:focus {
    border: round $theme-primary-muted;
}

Tree > .tree--guides {
    color: $theme-border;
}

Tree > .tree--guides-hover {
    color: $theme-primary;
}

Tree > .tree--guides-selected {
    color: $theme-primary-muted;
}

Tree > .tree--cursor {
    background: $theme-primary 30%;
    color: $theme-foreground;
}

Tree:focus > .tree--cursor {
    background: $theme-primary;
    color: $theme-background;
    text-style: bold;
}

Tree > .tree--highlight {
    text-style: bold;
}

Tree > .tree--highlight-line {
    background: $theme-surface-hover;
}

.directory-tree--folder {
    text-style: bold;
}

.directory-tree--file {
    color: $theme-foreground;
}

.directory-tree--hidden {
    text-style: dim italic;
}

/* =============================================================================
   DATATABLE
   ============================================================================= */

DataTable {
    background: $theme-surface;
    height: auto;
    border: round $theme-border;
}

DataTable:focus {
    border: round $theme-primary-muted;
}

DataTable > .datatable--header {
    background: $theme-surface-hover;
    color: $theme-primary-muted;
    text-style: bold;
}

DataTable > .datatable--header-hover {
    background: $theme-border;
    color: $theme-primary-muted;
    text-style: bold;
}

DataTable > .datatable--cursor {
    background: $theme-primary 30%;
    color: $theme-foreground;
}

DataTable:focus > .datatable--cursor {
    background: $theme-primary;
    color: $theme-background;
}

DataTable > .datatable--hover {
    background: $theme-surface-hover;
}

DataTable > .datatable--even-row {
    background: $theme-surface;
}

DataTable > .datatable--odd-row {
    background: $theme-background;
}

/* =============================================================================
   OPTION LIST
   ============================================================================= */

OptionList {
    background: $theme-surface;
    border: round $theme-border;
    padding: $spacing-0;
}

OptionList:focus {
    border: round $theme-primary-muted;
}

OptionList > .option-list--option {
    padding: $spacing-0 $spacing-1;
}

OptionList > .option-list--option-hover {
    background: $theme-surface-hover;
}

OptionList > .option-list--option-highlighted {
    background: $theme-primary;
    color: $theme-background;
    text-style: bold;
}

OptionList > .option-list--option-hover-highlighted {
    background: $theme-primary-muted;
    color: $theme-background;
}

/* =============================================================================
   SELECT WIDGET
   ============================================================================= */

Select {
    border: round $theme-border;
    background: $theme-surface;
}

Select:focus {
    border: round $theme-primary-muted;
}

Select > SelectCurrent {
    background: $theme-surface;
    color: $theme-foreground;
}

Select > SelectOverlay {
    border: round $theme-primary-muted;
    background: $theme-surface;
}

SelectOverlay > OptionList {
    border: none;
}

/* =============================================================================
   BUTTONS
   ============================================================================= */

Button {
    min-width: 10;
    height: $spacing-3;
    background: $theme-surface;
    color: $theme-foreground;
    border: tall $theme-border;
    text-style: bold;
}

Button:hover {
    background: $theme-surface-hover;
    border: tall $theme-primary;
}

Button:focus {
    border: tall $theme-primary-muted;
    text-style: bold reverse;
}

Button.-primary {
    background: $theme-primary;
    color: $theme-background;
    border: tall $theme-primary;
}

Button.-primary:hover {
    background: $theme-primary-muted;
    border: tall $theme-primary-muted;
}

Button.-success {
    background: $theme-success;
    color: $theme-background;
    border: tall $theme-success;
}

Button.-warning {
    background: $theme-warning;
    color: $theme-background;
    border: tall $theme-warning;
}

Button.-error {
    background: $theme-error;
    color: $theme-background;
    border: tall $theme-error;
}

Button:disabled {
    background: $theme-border;
    color: $theme-foreground-muted;
    text-style: dim;
}

/* =============================================================================
   CHECKBOX & SWITCH
   ============================================================================= */

Checkbox {
    background: transparent;
    border: none;
    padding: $spacing-0;
}

Checkbox:focus {
    background: $theme-surface-hover;
}

Checkbox > .toggle--button {
    background: $theme-border;
}

Checkbox.-on > .toggle--button {
    color: $theme-primary;
}

Checkbox:hover > .toggle--button {
    background: $theme-primary 30%;
}

Switch {
    background: transparent;
    border: none;
}

Switch:focus {
    border: tall $theme-primary-muted;
}

Switch > .switch--slider {
    background: $theme-border;
    color: $theme-foreground-muted;
}

Switch.-on > .switch--slider {
    color: $theme-primary;
}

/* =============================================================================
   COMMAND PALETTE
   ============================================================================= */

CommandPalette {
    layer: palette;
    position: absolute;
    align: center middle;
    display: none;
    width: 70%;
    max-width: 80;
    height: auto;
    max-height: 60%;
    background: $theme-surface;
    border: round $theme-border;
    padding: $spacing-1 $spacing-2;
}

CommandPalette.-visible {
    display: block;
}

CommandPalette > .palette-input {
    width: 100%;
    margin-bottom: $spacing-1;
}

CommandPalette > .palette-input > Input {
    border: round $theme-primary;
}

CommandPalette > .palette-input > Input:focus {
    border: round $theme-primary-muted;
}

CommandPalette > .palette-list {
    height: auto;
    max-height: 20;
    background: $theme-background;
    border: none;
}

CommandPalette > .palette-hint {
    height: 1;
    padding-top: $spacing-1;
    color: $theme-foreground-muted;
    text-align: center;
}

/* =============================================================================
   SPINNERS
   ============================================================================= */

KnightRiderSpinner {
    height: 1;
    padding: $spacing-0 $spacing-1;
    background: transparent;
}

KnightRiderSpinner .spinner-bar {
    width: auto;
}

KnightRiderSpinner .spinner-message {
    padding-left: $spacing-1;
    color: $theme-foreground-muted;
    text-style: dim;
}

KnightRiderSpinner .spinner-char-full {
    color: $theme-primary-muted;
}

KnightRiderSpinner .spinner-char-high {
    color: $theme-primary-muted 80%;
}

KnightRiderSpinner .spinner-char-medium {
    color: $theme-primary-muted 60%;
}

KnightRiderSpinner .spinner-char-low {
    color: $theme-primary-muted 40%;
}

KnightRiderSpinner .spinner-char-fade {
    color: $theme-primary-muted 20%;
}

CompactSpinner {
    width: auto;
    height: 1;
}

CompactSpinner .spinner-char {
    color: $theme-primary-muted;
    text-style: bold;
}

CompactSpinner .spinner-message {
    color: $theme-foreground-muted;
    text-style: dim;
}

ProgressSpinner {
    height: 1;
    width: 100%;
}

ProgressSpinner .spinner-char {
    color: $theme-primary-muted;
    text-style: bold;
}

ProgressSpinner .progress-bar-filled {
    color: $theme-primary-muted;
}

ProgressSpinner .progress-bar-empty {
    color: $theme-border;
    text-style: dim;
}

ProgressSpinner .progress-percent {
    color: $theme-foreground;
    text-style: bold;
}

ProgressSpinner .progress-message {
    color: $theme-foreground-muted;
    text-style: dim;
}

/* =============================================================================
   RICH PROMPT INPUT
   ============================================================================= */

RichPromptInput {
    height: auto;
    min-height: 3;
    max-height: 10;
    background: $theme-surface;
    border: round $theme-primary;
    padding: $spacing-0 $spacing-1;
}

RichPromptInput:focus-within {
    border: round $theme-primary-muted;
}

RichPromptInput > .prompt-prefix {
    width: 3;
    color: $theme-primary-muted;
}

RichPromptInput > .prompt-input {
    width: 1fr;
}

RichPromptInput > .prompt-parts {
    height: auto;
    padding-top: $spacing-1;
    color: $theme-foreground-muted;
}

RichPromptInput .part-attached-label {
    color: $theme-foreground-muted;
    text-style: dim;
}

RichPromptInput .part-separator {
    color: $theme-border;
}

RichPromptInput .part-label {
    color: $theme-primary-muted;
}

RichPromptInput.-multiline {
    min-height: 5;
    max-height: 15;
}

/* =============================================================================
   DIALOGS
   ============================================================================= */

BaseDialog {
    layer: dialog;
    align: center middle;
    width: 60;
    height: auto;
    max-height: 80%;
    background: $theme-surface;
    border: round $theme-border;
    padding: $spacing-0;
}

BaseDialog > .dialog-title-bar {
    width: 100%;
    height: $spacing-3;
    background: transparent;
    border-bottom: solid $theme-border;
    padding: $spacing-1 $spacing-2;
}

BaseDialog > .dialog-title-bar > .dialog-title {
    text-style: bold;
    color: $theme-primary-muted;
}

BaseDialog > .dialog-content {
    width: 100%;
    height: auto;
    padding: $spacing-1 $spacing-2;
}

BaseDialog > .dialog-actions {
    width: 100%;
    height: $spacing-3;
    padding: $spacing-0 $spacing-2;
    border-top: solid $theme-border;
    align: right middle;
}

BaseDialog > .dialog-actions > Button {
    margin-left: $spacing-1;
}

/* --- Confirm Dialog --- */
ConfirmDialog {
    width: 50;
}

ConfirmDialog > .dialog-content > .confirm-message {
    padding: $spacing-1 $spacing-0;
}

/* --- Input Dialog --- */
InputDialog {
    width: 50;
}

InputDialog > .dialog-content > .input-prompt {
    padding-bottom: $spacing-1;
}

InputDialog > .dialog-content > Input {
    width: 100%;
}

InputDialog > .dialog-content > .input-error {
    color: $theme-error;
    padding-top: $spacing-1;
}

/* --- Select Dialog --- */
SelectDialog {
    width: 60;
    height: auto;
    max-height: 70%;
}

SelectDialog > .dialog-content > .select-prompt {
    padding-bottom: $spacing-1;
}

SelectDialog > .dialog-content > OptionList {
    height: auto;
    max-height: 15;
    background: $theme-background;
    border: round $theme-border;
}

/* --- Fatal Error Dialog --- */
FatalErrorDialog {
    width: 70;
    height: auto;
    max-height: 80%;
    border: round $theme-error;
}

FatalErrorDialog > .dialog-title-bar {
    background: $theme-error 30%;
}

FatalErrorDialog > .dialog-title-bar > .dialog-title {
    color: $theme-error;
}

FatalErrorDialog > .dialog-content > .error-icon {
    text-align: center;
    padding: $spacing-1;
}

FatalErrorDialog > .dialog-content > .error-type {
    color: $theme-error;
    text-style: bold;
    padding-bottom: $spacing-1;
}

FatalErrorDialog > .dialog-content > .error-message {
    padding-bottom: $spacing-1;
}

FatalErrorDialog > .dialog-content > .error-traceback {
    background: $theme-background;
    border: round $theme-border;
    padding: $spacing-1;
    max-height: 10;
    overflow-y: scroll;
}

FatalErrorDialog > .dialog-content > .error-traceback > Static {
    color: $theme-foreground-muted;
}

FatalErrorDialog > .dialog-content > .error-help {
    padding-top: $spacing-1;
    color: $theme-foreground-muted;
}

ErrorNotification {
    width: 100%;
    height: auto;
    background: $theme-error 20%;
    border: round $theme-error;
    padding: $spacing-1;
    display: none;
}

ErrorNotification.-visible {
    display: block;
}

ErrorNotification > .error-content {
    color: $theme-error;
}

ErrorNotification > .error-dismiss {
    dock: right;
    width: auto;
    color: $theme-foreground-muted;
}

/* =============================================================================
   LEADER KEY INDICATOR
   ============================================================================= */

.leader-indicator {
    dock: bottom;
    height: 1;
    background: $theme-primary 30%;
    color: $theme-primary-muted;
    text-align: center;
    padding: $spacing-0 $spacing-2;
}

/* =============================================================================
   IMAGINATION PANEL
   ============================================================================= */

ImaginationPanel {
    layer: imagination;
    width: 100%;
    height: 100%;
    layout: grid;
    grid-size: 2 3;
    grid-columns: 60% 40%;
    grid-rows: auto 1fr auto;
    background: $theme-background;
}

ImaginationPanel > .imag-header {
    column-span: 2;
    height: $spacing-3;
    background: $theme-surface;
    border-bottom: solid $theme-primary-muted;
}

ImaginationPanel > .imag-left-pane {
    row-span: 1;
    height: 100%;
    padding: $spacing-1;
    border-right: solid $theme-primary;
    overflow-y: auto;
}

ImaginationPanel > .imag-right-pane {
    row-span: 1;
    height: 100%;
    padding: $spacing-1;
    overflow-y: auto;
}

ImaginationPanel > .imag-footer {
    column-span: 2;
    height: auto;
    padding: $spacing-1;
    border-top: solid $theme-primary;
    background: $theme-surface;
}

ImaginationPanel .section-header {
    margin: $spacing-1 $spacing-0;
    padding: $spacing-0 $spacing-1;
    color: $theme-primary-muted;
    text-style: bold;
}

ImaginationPanel .stats-row {
    height: auto;
    margin-bottom: $spacing-1;
    background: $theme-surface;
    border: round $theme-primary;
    padding: $spacing-1;
}

ImaginationPanel .category-section {
    height: auto;
    margin-bottom: $spacing-1;
}

CategoryBreakdown {
    width: 100%;
    height: auto;
    padding: $spacing-1;
    background: transparent;
}

ImaginationPanel .extension-section {
    height: auto;
    margin-bottom: $spacing-1;
    padding: $spacing-1;
    background: $theme-surface;
    border: round $theme-border;
}

ExtensionCloud {
    width: 100%;
    height: auto;
    padding: $spacing-0;
}

ImaginationPanel .file-tree {
    height: 1fr;
    min-height: 15;
    background: $theme-background;
    border: round $theme-border;
    padding: $spacing-1;
}

ImaginationPanel .file-tree > Tree {
    background: transparent;
}

ImaginationPanel .activity-section {
    height: 100%;
}

RecentActivity {
    width: 100%;
    height: 100%;
    padding: $spacing-1;
    background: $theme-background;
    border: round $theme-primary-muted;
}

ImaginationPanel .action-bar {
    height: $spacing-3;
    align: center middle;
}

ImaginationPanel .action-bar > Button {
    margin: $spacing-0 $spacing-1;
    min-width: 12;
}

HolographicHeader {
    width: 100%;
    height: $spacing-3;
    background: $theme-surface;
    border-bottom: solid $theme-primary-muted;
    padding: $spacing-0 $spacing-2;
    content-align: center middle;
}

ScanStats {
    width: 100%;
    height: auto;
    padding: $spacing-1;
    background: $theme-surface;
    border: round $theme-primary;
}

ImaginationCompact {
    width: 100%;
    height: auto;
    padding: $spacing-1;
    border: round $theme-primary-muted;
    background: $theme-surface;
}

ImaginationPanel *:focus {
    border: double $theme-primary-muted;
}

#imagination_panel {
    layer: imagination;
    width: 100%;
    height: 100%;
    background: $theme-background;
}

#imagination_panel.-hidden {
    display: none;
}

#main_content.-hidden {
    display: none;
}

/* --- Holographic Effects --- */
.holo-pulse {
    text-style: bold;
}

.holo-scanning {
    color: $theme-secondary;
    text-style: bold;
}

.holo-watching {
    color: $theme-success;
    text-style: bold;
}

.holo-error {
    color: $theme-error;
    text-style: bold;
}

.holo-border {
    border: double $theme-primary-muted;
    background: $theme-surface;
}

.neon-cyan {
    color: $theme-primary-muted;
    text-style: bold;
}

.neon-magenta {
    color: $theme-secondary;
    text-style: bold;
}

.neon-green {
    color: $theme-success;
    text-style: bold;
}

.neon-amber {
    color: $theme-warning;
    text-style: bold;
}

/* =============================================================================
   MEMORY BROWSER
   ============================================================================= */

MemoryBrowser {
    width: 100%;
    height: 100%;
    padding: $spacing-0;
}

MemoryBrowser .memory-header {
    text-align: center;
    color: $theme-primary-muted;
    text-style: bold;
    padding: $spacing-1;
    border-bottom: solid $theme-border;
}

MemoryBrowser .search-bar {
    height: $spacing-3;
    padding: $spacing-0 $spacing-1;
    border-bottom: solid $theme-border;
}

MemoryBrowser .search-input {
    width: 1fr;
}

MemoryBrowser .search-button {
    width: auto;
    margin-left: $spacing-1;
}

MemoryBrowser .memory-content {
    height: 1fr;
}

MemoryBrowser .message-detail {
    padding: $spacing-1;
    background: $theme-surface;
    border: round $theme-border;
    margin: $spacing-1;
    height: 1fr;
}

MemoryBrowser .message-role {
    color: $theme-primary;
    text-style: bold;
}

MemoryBrowser .message-content {
    margin-top: $spacing-1;
}

MemoryBrowser .message-meta {
    color: $theme-foreground-muted;
    text-style: italic;
    margin-top: $spacing-1;
}

MemoryBrowser .state-tree {
    height: 100%;
}

MemoryBrowser .action-bar {
    height: $spacing-3;
    padding: $spacing-1;
    border-top: solid $theme-border;
    align: center middle;
}

MemoryBrowser .log-entry {
    margin-bottom: $spacing-1;
}

MemoryBrowser .log-label {
    color: $theme-primary-muted;
    text-style: bold;
}

MemoryBrowser .log-content {
    color: $theme-foreground;
}

/* =============================================================================
   TEST RUNNER PANEL
   ============================================================================= */

TestRunnerPanel {
    width: 100%;
    height: 100%;
    layout: grid;
    grid-size: 2 1;
    grid-columns: 40% 1fr;
}

TestRunnerPanel .test-list-pane {
    height: 100%;
    border-right: solid $theme-primary;
    padding: $spacing-1;
}

TestRunnerPanel .test-output-pane {
    height: 100%;
    padding: $spacing-1;
}

TestRunnerPanel .pane-header {
    color: $theme-primary-muted;
    text-style: bold;
    padding-bottom: $spacing-1;
    border-bottom: solid $theme-border;
    margin-bottom: $spacing-1;
}

TestRunnerPanel .summary-bar {
    height: $spacing-3;
    padding: $spacing-1;
    border-bottom: solid $theme-border;
}

TestRunnerPanel .summary-passed {
    color: $theme-success;
}

TestRunnerPanel .summary-failed {
    color: $theme-error;
}

TestRunnerPanel .summary-skipped {
    color: $theme-warning;
}

TestRunnerPanel .test-tree {
    height: 1fr;
}

TestRunnerPanel .output-log {
    height: 1fr;
    background: $theme-background;
    border: round $theme-border;
    padding: $spacing-1;
}

TestRunnerPanel .log-entry {
    margin-bottom: $spacing-1;
}

TestRunnerPanel .log-start {
    color: $theme-primary-muted;
    text-style: bold;
}

TestRunnerPanel .log-success {
    color: $theme-success;
}

TestRunnerPanel .log-error {
    color: $theme-error;
    text-style: bold;
}

TestRunnerPanel .log-warning {
    color: $theme-warning;
}

TestRunnerPanel .log-info {
    color: $theme-foreground-muted;
    text-style: dim;
}

/* =============================================================================
   TOOL REGISTRY PANEL
   ============================================================================= */

ToolRegistryPanel {
    width: 100%;
    height: 100%;
    layout: grid;
    grid-size: 2 1;
    grid-columns: 35% 1fr;
}

ToolRegistryPanel .tool-list-pane {
    height: 100%;
    border-right: solid $theme-primary;
    padding: $spacing-1;
}

ToolRegistryPanel .tool-output-pane {
    height: 100%;
    padding: $spacing-1;
}

ToolRegistryPanel .pane-header {
    color: $theme-primary-muted;
    text-style: bold;
    padding-bottom: $spacing-1;
    border-bottom: solid $theme-border;
    margin-bottom: $spacing-1;
}

ToolRegistryPanel .tool-search {
    margin-bottom: $spacing-1;
}

ToolRegistryPanel .tool-table {
    height: 1fr;
}

ToolRegistryPanel .output-log {
    height: 1fr;
    background: $theme-background;
    border: round $theme-border;
    padding: $spacing-1;
}

ToolRegistryPanel .log-entry {
    margin-bottom: $spacing-1;
}

ToolRegistryPanel .log-start {
    color: $theme-primary-muted;
    text-style: bold;
}

ToolRegistryPanel .log-success {
    color: $theme-success;
}

ToolRegistryPanel .log-error {
    color: $theme-error;
    text-style: bold;
}

ToolRegistryPanel .log-warning {
    color: $theme-warning;
}

ToolRegistryPanel .log-info {
    color: $theme-foreground-muted;
    text-style: dim;
}

ToolRegistryPanel .log-label {
    color: $theme-primary-muted;
    text-style: bold;
}

ToolRegistryPanel .tool-actions {
    height: $spacing-3;
    margin-top: $spacing-1;
    align: center middle;
}

/* =============================================================================
   IDE PANEL - Refactoring Panel
   ============================================================================= */

IDEPanel {
    width: 100%;
    height: 100%;
}

RefactoringPanel {
    width: 100%;
    height: 100%;
    padding: $spacing-1;
}

RefactoringPanel .refactor-header {
    color: $theme-primary-muted;
    text-style: bold;
    padding-bottom: $spacing-1;
    border-bottom: solid $theme-border;
    margin-bottom: $spacing-1;
}

RefactoringPanel .refactor-list {
    height: 40%;
}

RefactoringPanel .refactor-preview {
    height: 50%;
    background: $theme-background;
    border: round $theme-border;
    margin-top: $spacing-1;
    padding: $spacing-1;
}

RefactoringPanel .refactor-preview .log-entry {
    margin-bottom: $spacing-1;
}

RefactoringPanel .refactor-preview .log-label {
    color: $theme-primary-muted;
    text-style: bold;
}

RefactoringPanel .refactor-preview .log-content {
    color: $theme-foreground-muted;
    text-style: dim;
}

RefactoringPanel .refactor-preview .log-warning {
    color: $theme-warning;
}

RefactoringPanel .refactor-actions {
    height: $spacing-3;
    margin-top: $spacing-1;
    align: center middle;
}

/* =============================================================================
   CHARTS
   ============================================================================= */

ASCIILineChart {
    width: 100%;
    height: auto;
    min-height: 8;
    padding: $spacing-1;
}

ASCIILineChart .chart-title {
    color: $theme-primary-muted;
    text-style: bold;
    margin-bottom: $spacing-1;
}

ASCIILineChart .chart-empty {
    color: $theme-foreground-muted;
    text-style: dim;
}

BarChart {
    width: 100%;
    height: auto;
    padding: $spacing-1;
}

BarChart .chart-title {
    color: $theme-primary-muted;
    text-style: bold;
    margin-bottom: $spacing-1;
}

BarChart .chart-empty {
    color: $theme-foreground-muted;
    text-style: dim;
}

BarChart .bar-label {
    color: $theme-foreground;
    text-style: bold;
}

BarChart .bar-value {
    color: $theme-foreground-muted;
    text-style: dim;
}

VerticalBarChart {
    width: 100%;
    height: auto;
    min-height: 10;
    padding: $spacing-1;
}

VerticalBarChart .chart-title {
    color: $theme-primary-muted;
    text-style: bold;
    margin-bottom: $spacing-1;
}

VerticalBarChart .chart-empty {
    color: $theme-foreground-muted;
    text-style: dim;
}

MetricGauge {
    width: auto;
    height: $spacing-3;
    padding: $spacing-0 $spacing-1;
}

MetricGauge .gauge-label {
    color: $theme-foreground;
    text-style: bold;
}

MetricGauge .gauge-value {
    color: $theme-foreground-muted;
    text-style: dim;
}

MetricGauge .gauge-bar-filled {
    color: $theme-primary-muted;
}

MetricGauge .gauge-bar-empty {
    color: $theme-border;
    text-style: dim;
}

MetricGauge .gauge-bar-critical {
    color: $theme-error;
}

MetricGauge .gauge-bar-warning {
    color: $theme-warning;
}

/* =============================================================================
   TOOLS MENU
   ============================================================================= */
.tools-container {
    width: 70;
    height: auto;
}

.header-container {

    height: auto;
    width: 100%;
    align: center middle;
    margin-bottom: $spacing-2;
}

.screen-header-text {
    width: auto;
    padding: $spacing-1 $spacing-2;
    border: thick $theme-primary;
    text-style: bold;
    color: $theme-primary;
    background: $theme-surface;
    text-align: center;
}

.tools-availability-summary {
    width: 100%;
    height: 1;
    margin: 0 2;
    color: $theme-foreground-muted;
    text-align: center;
    text-style: dim;
}

.tools-grid {
    grid-size: 3;
    grid-columns: 1fr 1fr 1fr;
    grid-gutter: 1 2;
    padding: 0 2;
    width: 100%;
    height: auto;
    align: center middle;
}

.tool-card {
    width: 32;
    height: 12;
    border: round $theme-border;
    background: $theme-surface;
    padding: 1;
}

.tool-card.selected {
    border: round $theme-primary;
    background: $theme-surface-hover;
}

.tool-card.unavailable {
    opacity: 0.5;

}

.tool-icon-large {
    width: 5;
    height: auto;
    text-align: center;
    content-align: center middle;
    text-style: bold;

    color: $theme-primary;
    margin-right: 1;
}

.tool-card .horizontalgroup > VerticalGroup {
    width: 1fr;
    height: auto;
}

.tool-card-name {
    width: 1fr;
    text-style: bold;
    color: $theme-foreground;
}

.tool-card-description {
    width: 1fr;
    color: $theme-foreground-muted;
}

.tool-card-footer {
    dock: bottom;
    height: 1;
    align: center middle;
}

.tool-status-badge.available {
    color: $theme-success;
}

.tool-status-badge.unavailable {
    color: $theme-error;
}

.action-hint {
    margin-top: 2;
    align: center middle;
    color: $theme-foreground-muted;
}

.action-hint-text {
    width: auto;
    height: 1;
}

.action-key {
    width: auto;
    height: 1;
    color: $theme-primary-muted;
    text-style: bold;
}


/* =============================================================================
   CONSTITUTION SCREEN
   ============================================================================= */

ConstitutionScreen {
    align: center middle;
}

ConstitutionScreen #dialog {
    width: 80;
    max-height: 90vh;
    background: $theme-surface;
    border: round $theme-border-active;
    padding: $spacing-1 $spacing-2;
}

ConstitutionScreen #title {
    text-align: center;
    color: $theme-primary;
    text-style: bold;
    margin-bottom: $spacing-1;
}

ConstitutionScreen #step-label {
    color: $theme-foreground-muted;
    margin-bottom: $spacing-1;
}

ConstitutionScreen .question-label {
    color: $theme-foreground;
    margin-top: $spacing-1;
}

ConstitutionScreen #stage-select {
    margin-bottom: $spacing-1;
}

ConstitutionScreen #answer-input {
    margin-bottom: $spacing-1;
}

ConstitutionScreen #buttons {
    margin-top: $spacing-1;
    height: $spacing-3;
}

ConstitutionScreen #btn-next {
    dock: right;
}

ConstitutionScreen #btn-cancel {
    dock: left;
}

/* =============================================================================
   MONITOR SCREEN (Browser)
   ============================================================================= */

MonitorScreen {
    background: $theme-background;
    color: $theme-foreground;
}

MonitorScreen #browser-container {
    height: 1fr;
    border: round $theme-border;
}

MonitorScreen #browser-container > Vertical {
    width: 100%;
    height: 100%;
}

MonitorStatusBar {
    height: $spacing-3;
    background: $theme-surface;
    border-top: solid $theme-border;
}

TabBar {
    height: $spacing-3;
    background: $theme-surface;
    border-bottom: solid $theme-border;
}

TabBar .active-tab {
    background: $theme-primary 20%;
    color: $theme-primary;
    text-style: bold;
}

TabBar .new-tab-btn {
    color: $theme-foreground-muted;
    min-width: $spacing-3;
}

AddressBar {
    height: $spacing-3;
    background: $theme-background-secondary;
    border-bottom: solid $theme-border;
    padding: $spacing-0 $spacing-1;
}

AddressBar .nav-btn {
    min-width: $spacing-4;
    background: $theme-surface;
    color: $theme-foreground;
    border: none;
}

AddressBar .nav-btn:hover {
    background: $theme-surface-hover;
    color: $theme-primary;
}

AddressBar .url-input {
    width: 1fr;
    margin: $spacing-0 $spacing-1;
}

AddressBar .status {
    color: $theme-foreground-muted;
    width: 20;
    text-align: right;
}

ContentViewer {
    background: $theme-background-tertiary;
    padding: $spacing-1 $spacing-2;
}

ContentViewer .loading-message {
    color: $theme-primary;
    text-style: italic;
}

ContentViewer .error-message {
    color: $theme-error;
}

ContentViewer .empty-message {
    color: $theme-foreground-muted;
    text-style: italic;
}

/* =============================================================================
   AURA SHELL — modal & tool screen layout (tui/shell/)
   ============================================================================= */

BaseAuraModalScreen, ConstitutionScreen, DiffConfirmationScreen, TokenUsageScreen {
    align: center middle;
}

.aura-modal-root, ConstitutionScreen #dialog, DiffConfirmationScreen #diff-dialog-root {
    width: 80;
    max-height: 90vh;
    background: $theme-surface;
    border: round $theme-border-active;
    padding: $spacing-1 $spacing-2;
}

.aura-modal-title {
    text-align: center;
}

.aura-tool-screen {
    width: 100%;
    height: 100%;
}

.aura-tool-chrome {
    width: 100%;
    margin-bottom: $spacing-1;
}

DiffConfirmationScreen #diff-dialog {
    width: 100%;
    max-height: 70vh;
    border: none;
    padding: 0;
}

/* Token Usage keeps the shared modal frame but avoids an inner second frame. */
TokenUsageScreen #token_usage_modal {
    width: 68;
}

TokenUsageScreen #token_usage_dialog {
    width: 100%;
    height: auto;
    padding: 0;
    background: transparent;
    border: none;
}


/* ===== Merged widget rules (ex-macos_light.tcss), colors tokenized to $theme-* ===== */
AuraStatusSidebar {
    height: 1fr;
    padding: 1;
    width: 100%;
    overflow-y: auto;
    background: $theme-surface;
}
MetricsPanel #metrics_display {
    width: 100%;
    height: auto;
    padding: 0 1;
}
MetricsPanel .metric-row {
    height: 1;
    margin-bottom: 1;
}
MetricsPanel .metric-key {
    width: 20;
    text-align: right;
    color: $theme-foreground-muted;
    text-style: dim;
    padding-right: 1;
}
MetricsPanel .metric-value {
    width: 1fr;
    text-align: left;
    color: $theme-success;
    text-style: bold;
}
MessageBubble.message-user .message-body {
    color: $theme-foreground;
}
MessageBubble.message-user .message-timestamp {
    color: $theme-foreground-muted;
}
HolographicHeader .scan-indicator {
    color: $theme-primary;
    text-style: bold;
    margin: 0 1;
}
HolographicHeader .title {
    color: $theme-primary;
    text-style: bold;
}
HolographicHeader .status-idle {
    color: $theme-foreground-muted;
    text-style: dim;
}
HolographicHeader .status-scanning {
    color: $theme-secondary;
    text-style: bold;
}
HolographicHeader .status-watching {
    color: $theme-success;
    text-style: bold;
}
HolographicHeader .status-error {
    color: $theme-error;
    text-style: bold;
}
CategoryBreakdown .category-row {
    height: 1;
    margin-bottom: 1;
}
CategoryBreakdown .category-icon {
    margin-right: 1;
    text-style: bold;
}
CategoryBreakdown .category-name {
    width: 10;
    text-style: bold;
}
CategoryBreakdown .category-bar-fill {
    background: $theme-primary;
    height: 1;
}
CategoryBreakdown .category-bar-empty {
    background: $theme-foreground-muted;
    height: 1;
    opacity: 0.3;
}
CategoryBreakdown .category-count {
    margin-left: 1;
    text-style: bold;
}
CategoryBreakdown .category-percent {
    color: $theme-foreground-muted;
    text-style: dim;
}
RecentActivity .activity-header {
    color: $theme-primary;
    text-style: bold;
    border-bottom: solid $theme-border;
    margin-bottom: 1;
    padding-bottom: 1;
}
RecentActivity .activity-item {
    margin-bottom: 1;
    padding: 0 1;
}
RecentActivity .activity-icon {
    margin-right: 1;
    text-style: bold;
}
RecentActivity .activity-name {
    text-style: bold;
    width: 25;
}
RecentActivity .activity-time {
    color: $theme-foreground-muted;
    text-style: dim;
}
ExtensionCloud .extension-item {
    margin: 0 1;
}
ExtensionCloud .extension-high {
    color: $theme-primary;
    text-style: bold;
}
ExtensionCloud .extension-medium {
    color: $theme-primary;
}
ExtensionCloud .extension-low {
    color: $theme-foreground-muted;
    text-style: dim;
}
ScanStats .stat-item {
    margin: 0 1;
}
ScanStats .stat-label {
    color: $theme-foreground-muted;
    text-style: dim;
}
ScanStats .stat-value {
    color: $theme-primary;
    text-style: bold;
}
ScanStats .stat-separator {
    color: $theme-foreground-muted;
    margin: 0 1;
}
TestRunnerPanel .action-bar {
    height: 3;
    margin-top: 1;
    align: center middle;
}
TestRunnerPanel .progress-container {
    height: 1;
    margin: 1 0;
}
ToolRegistryPanel .status-idle {
    color: $theme-foreground-muted;
}
ToolRegistryPanel .status-running {
    color: $theme-warning;
}
ToolRegistryPanel .status-success {
    color: $theme-success;
}
ToolRegistryPanel .status-failed {
    color: $theme-error;
}
ToolRegistryPanel .progress-container {
    height: 1;
    margin-bottom: 1;
}
FileTreePanel {
    width: 100%;
    height: 100%;
    padding: 0;
}
StatsDisplay {
    width: 100%;
    height: auto;
    padding: 1;
}
StatsDisplay .stats-title {
    color: $theme-primary;
    text-style: bold;
}
StatsDisplay .stats-border {
    color: $theme-border;
}
StatsDisplay .stats-key {
    color: $theme-foreground;
    text-style: bold;
}
MiniSparkline {
    width: auto;
    height: 1;
}
CodeScreen {
    background: $theme-background;
}
CodeScreen .screen-header {
    text-align: center;
    color: $theme-primary;
    text-style: bold;
    margin-bottom: 2;
}
CodeScreen .status-available {
    color: $theme-success;
    text-style: bold;
}
CodeScreen .status-unavailable {
    color: $theme-error;
    text-style: bold;
}
CodeScreen .description-text {
    color: $theme-foreground-muted;
    text-style: dim;
    margin: 1 0;
}
CodeScreen .features-label {
    color: $theme-warning;
    text-style: bold;
    margin-top: 1;
}
CodeScreen .action-hint {
    color: $theme-success;
    margin: 1 0;
}
CodeScreen .action-key {
    color: $theme-primary;
    text-style: bold;
}
CodeScreen .install-hint {
    color: $theme-warning;
    margin: 1 0;
}
CodeScreen .install-command {
    color: $theme-primary;
}
PaintScreen {
    background: $theme-background;
}
PaintScreen .screen-header {
    text-align: center;
    color: $theme-secondary;
    text-style: bold;
    margin-bottom: 2;
}
PaintScreen .status-available {
    color: $theme-success;
    text-style: bold;
}
PaintScreen .status-unavailable {
    color: $theme-error;
    text-style: bold;
}
PaintScreen .description-text {
    color: $theme-foreground-muted;
    text-style: dim;
    margin: 1 0;
}
PaintScreen .features-label {
    color: $theme-warning;
    text-style: bold;
    margin-top: 1;
}
PaintScreen .action-hint {
    color: $theme-success;
    margin: 1 0;
}
PaintScreen .action-key {
    color: $theme-primary;
    text-style: bold;
}
PaintScreen .install-hint {
    color: $theme-warning;
    margin: 1 0;
}
PaintScreen .install-command {
    color: $theme-primary;
}
FilesScreen {
    background: $theme-background;
}
FilesScreen .screen-header {
    text-align: center;
    color: $theme-success;
    text-style: bold;
    margin-bottom: 2;
}
FilesScreen .status-available {
    color: $theme-success;
    text-style: bold;
}
FilesScreen .status-unavailable {
    color: $theme-error;
    text-style: bold;
}
FilesScreen .description-text {
    color: $theme-foreground-muted;
    text-style: dim;
    margin: 1 0;
}
FilesScreen .features-label {
    color: $theme-warning;
    text-style: bold;
    margin-top: 1;
}
FilesScreen .action-hint {
    color: $theme-success;
    margin: 1 0;
}
FilesScreen .action-key {
    color: $theme-primary;
    text-style: bold;
}
FilesScreen .install-hint {
    color: $theme-warning;
    margin: 1 0;
}
FilesScreen .install-command {
    color: $theme-primary;
}
.screen-header {
    color: $theme-primary;
    text-style: bold;
    text-align: center;
}
.status-available {
    color: $theme-success;
    text-style: bold;
}
.status-unavailable {
    color: $theme-error;
    text-style: bold;
}
.description-text {
    color: $theme-foreground-muted;
    text-style: dim;
    margin: 1 0;
}
.features-label {
    color: $theme-warning;
    text-style: bold;
    margin-top: 1;
}
.install-hint {
    color: $theme-warning;
    margin: 1 0;
}
.install-command {
    color: $theme-primary;
}
ToolsMenuScreen {
    background: $theme-background;
}
ToolsMenuScreen .tools-container {
    width: 70;
    height: auto;
    margin: 0;
    padding: 0;
    border: none;
    background: $theme-background;
}
ToolsMenuScreen .header-container {
    width: 100%;
    height: auto;
    margin: 0;
    padding: 0;
    border: round $theme-border;
    background: $theme-surface;
}
ToolsMenuScreen .screen-header {
    text-align: center;
    color: $theme-primary;
    text-style: bold;
    margin: 0;
    padding: 0;
}
ToolsMenuScreen .tools-availability-summary {
    width: 100%;
    height: 1;
    margin: 0 2;
    color: $theme-foreground-muted;
    text-align: center;
    text-style: dim;
}
ToolsMenuScreen .tools-grid {
    layout: grid;
    grid-size: 3;
    grid-columns: 1fr 1fr 1fr;
    grid-rows: auto;
    grid-gutter: 1;
    width: 100%;
    height: auto;
    margin: 0;
    padding: 1;
}
ToolsMenuScreen .tool-card {
    width: 100%;
    height: auto;
    min-height: 5;
    padding: 0 1;
    margin: 0;
    border: round $theme-border;
    background: $theme-surface;
}
ToolsMenuScreen .tool-card:hover,
ToolsMenuScreen .tool-card.hover {
    background: $theme-primary 10%;
    border: round $theme-primary;
}
ToolsMenuScreen .tool-card.selected {
    background: $theme-primary 15%;
    border: heavy $theme-secondary;
}
ToolsMenuScreen .tool-card.unavailable {
    opacity: 0.6;
}
ToolsMenuScreen .tool-card.unavailable:hover,
ToolsMenuScreen .tool-card.unavailable.hover {
    background: $theme-error 10%;
    border: round $theme-error;
}
ToolsMenuScreen .tool-icon-large {
    width: 2;
    height: 1;
    text-align: center;
    content-align: center middle;
    margin-right: 0;
    color: $theme-primary;
    text-style: bold;
}
ToolsMenuScreen .tool-card.selected .tool-icon-large {
    color: $theme-secondary;
}
ToolsMenuScreen .tool-card-name {
    color: $theme-foreground;
    text-style: bold;
    margin-bottom: 0;
    margin-top: 0;
    width: 100%;
    height: 1;
}
ToolsMenuScreen .tool-card.selected .tool-card-name {
    color: $theme-secondary;
}
ToolsMenuScreen .tool-card-description {
    color: $theme-foreground-muted;
    text-style: dim;
    margin-bottom: 0;
    margin-top: 0;
    width: 100%;
    height: 1;
    text-align: left;
}
ToolsMenuScreen .tool-card-footer {
    width: 100%;
    height: 1;
    margin-top: 0;
    align: right middle;
}
ToolsMenuScreen .tool-status-badge {
    padding: 0;
    border: none;
    text-style: bold;
    width: auto;
}
ToolsMenuScreen .tool-status-badge.available {
    color: $theme-success;
}
ToolsMenuScreen .tool-status-badge.unavailable {
    color: $theme-error;
}
ToolsMenuScreen .action-hint {
    text-align: center;
    color: $theme-foreground-muted;
    margin-top: 0;
    padding: 0 1;
    height: 1;
}
ToolsMenuScreen .action-hint-text {
    width: auto;
    height: 1;
}
ToolsMenuScreen .action-key {
    width: auto;
    height: 1;
    color: $theme-secondary;
    text-style: bold;
    background: $theme-surface;
    padding: 0;
    border: none;
}
ToolsMenuScreen .status-available {
    color: $theme-success;
}
ToolsMenuScreen .status-unavailable {
    color: $theme-error;
}
DiffConfirmationScreen {
    align: center middle;
}
DiffConfirmationScreen #diff-header {
    height: 3;
    border-bottom: solid $theme-border;
    content-align: center middle;
    background: $theme-surface;
    padding: 0 1;
}
DiffConfirmationScreen #diff-header Label {
    width: 100%;
    text-align: center;
    color: $theme-primary;
    text-style: bold;
}
DiffConfirmationScreen #diff-stats {
    height: 2;
    padding: 0 1;
    background: $theme-background-secondary;
}
DiffConfirmationScreen .stat-added {
    color: $theme-success;
    text-style: bold;
}
DiffConfirmationScreen .stat-removed {
    color: $theme-error;
    text-style: bold;
}
DiffConfirmationScreen #diff-display {
    height: 1fr;
    background: $theme-surface;
    border: round $theme-border;
    padding: 1;
}
DiffConfirmationScreen .diff-line {
    margin-bottom: 0;
}
DiffConfirmationScreen .line-added {
    color: $theme-diff-add-fg;
    background: $theme-diff-add-bg;
}
DiffConfirmationScreen .line-removed {
    color: $theme-diff-remove-fg;
    background: $theme-diff-remove-bg;
}
DiffConfirmationScreen .line-header {
    color: $theme-primary;
    background: $theme-background-secondary;
    text-style: bold;
}
DiffConfirmationScreen .line-context {
    color: $theme-foreground-muted;
    text-style: dim;
}
DiffConfirmationScreen #button-bar {
    height: 4;
    align: center middle;
    padding: 1;
    background: $theme-surface;
    border-top: solid $theme-primary;
}
DiffConfirmationScreen #button-bar Button {
    margin: 0 1;
    min-width: 16;
}
DiffConfirmationScreen Button.accept {
    background: $theme-success;
    color: white;
}
DiffConfirmationScreen Button.reject {
    background: $theme-error;
    color: white;
}
DiffConfirmationScreen Button.edit {
    background: $theme-primary;
    color: white;
}
DiffConfirmationScreen Button.accept-all {
    background: $theme-warning;
    color: white;
}
HistoryApp Screen, HistoryScreen, HistoryBrowserPanel {
    background: $theme-background;
}
HistoryApp #search-container, HistoryScreen #search-container, HistoryBrowserPanel #search-container {
    height: 4;
    padding: 1;
    background: $theme-surface;
}
HistoryApp #search-input, HistoryScreen #search-input, HistoryBrowserPanel #search-input {
    width: 100%;
}
HistoryApp #content-container, HistoryScreen #content-container, HistoryBrowserPanel #content-container {
    height: 1fr;
}
HistoryApp #session-table, HistoryScreen #session-table, HistoryBrowserPanel #session-table {
    height: 2fr;
}
HistoryOption .history-timestamp {
    color: $theme-primary;
    text-style: bold;
}
HistoryOption .history-result {
    color: $theme-success;
    text-style: bold;
}
HistoryOption .history-result-error {
    color: $theme-error;
    text-style: bold;
}
HistoryOption .history-query {
    color: $theme-foreground;
    margin-top: 1;
}
HistoryOption .history-continuation {
    color: $theme-foreground-muted;
    text-style: dim;
    margin-top: 1;
}
HistoryApp #detail-panel, HistoryScreen #detail-panel, HistoryBrowserPanel #detail-panel {
    height: 1fr;
    border: solid $theme-border;
    padding: 1;
    background: $theme-surface;
}
HistoryApp #detail-panel .detail-path {
    color: $theme-primary;
    text-style: bold;
}
HistoryApp #detail-panel .detail-timestamp {
    color: $theme-warning;
}
HistoryApp #detail-panel .detail-cwd {
    color: $theme-success;
}
HistoryApp #detail-panel .detail-count {
    color: $theme-foreground;
}
HistoryApp #detail-panel .detail-label {
    color: $theme-primary;
    text-style: bold;
}
HistoryApp #detail-panel .detail-content {
    color: $theme-foreground-muted;
    text-style: dim;
}
HistoryApp #detail-panel .detail-separator {
    height: 1;
}
HistoryApp #filter-status, HistoryScreen #filter-status, HistoryBrowserPanel #filter-status {
    height: 2;
    padding: 0 1;
    background: $theme-background-secondary;
}
HistoryApp .highlight {
    background: $theme-primary 20%;
}
HistoryApp DataTable > .datatable--header {
    background: $theme-background-secondary;
    color: $theme-foreground;
}
HistoryApp DataTable > .datatable--cursor {
    background: $theme-primary 20%;
}
LLMSettingsPanel {
    width: 100%;
    height: 100%;
    padding: 1;
}
LLMSettingsPanel .settings-header {
    text-align: center;
    color: $theme-primary;
    text-style: bold;
    padding: 1;
    border-bottom: solid $theme-border;
    margin-bottom: 1;
}
LLMSettingsPanel .settings-section {
    margin: 1 0;
    padding: 1;
    border: round $theme-border;
    background: $theme-surface;
}
LLMSettingsPanel .section-title {
    color: $theme-primary;
    text-style: bold;
    margin-bottom: 1;
}
LLMSettingsPanel .field-row {
    height: auto;
    margin: 1 0;
}
LLMSettingsPanel .field-label {
    width: 20;
    color: $theme-foreground;
}
LLMSettingsPanel .field-help {
    color: $theme-foreground-muted;
    text-style: italic;
    margin-left: 2;
}
LLMSettingsPanel .button-row {
    margin-top: 2;
    align: center middle;
}
LLMSettingsPanel .save-button {
    margin-right: 2;
}
AutocompleteInput {
    height: auto;
}
AutocompleteInput > Input {
    width: 100%;
}
AutocompleteInput > .completion-list {
    layer: overlay;
    width: 100%;
    max-height: 10;
    background: $theme-surface;
    border: round $theme-border;
    padding: 0;
}
AutocompleteInput > .completion-list.-hidden {
    display: none;
}
AutocompleteInput .completion-item {
    padding: 0 1;
}
AutocompleteInput .completion-item:hover {
    background: $theme-primary 20%;
}
AutocompleteInput .completion-hint {
    height: 1;
    color: $theme-foreground-muted;
    padding: 0 1;
    text-style: dim;
}
MonitorViewer .monitor-title-text {
    text-style: bold;
    color: $theme-primary;
}
MonitorViewer .monitor-status-text {
    color: $theme-foreground-muted;
}
MonitorViewer .monitor-status-text.status-connected {
    color: $theme-success;
}
MonitorViewer .monitor-status-text.status-checking {
    color: $theme-warning;
}
MonitorViewer .monitor-info-content {
    padding: 1;
}
MonitorViewer .monitor-url {
    color: $theme-primary;
    text-style: bold;
}
MonitorViewer .monitor-description {
    color: $theme-foreground;
}
MonitorViewer .monitor-hint {
    color: $theme-foreground-muted;
}
LSPManagerWidget .status-row {
    width: 100%;
    height: 2;
    padding: 0 1;
    color: $theme-foreground-muted;
}
LSPManagerWidget .status-row.status-success {
    color: $theme-success;
}
LSPManagerWidget .status-row.status-error {
    color: $theme-error;
}
LSPManagerWidget DataTable .datatable--cell:first-child {
    text-align: center;
}
ShellConsoleWidget .console-status {
    color: $theme-foreground-muted;
}
ShellConsoleWidget .console-status.status-running {
    color: $theme-warning;
}
ShellConsoleWidget .console-status.status-ready {
    color: $theme-success;
}
ShellConsoleWidget .monitor-status {
    color: $theme-foreground-muted;
}
ShellConsoleWidget .monitor-status.stream-on {
    color: $theme-success;
}
ShellConsoleWidget .monitor-status.stream-streaming {
    color: $theme-success;
}
ShellConsoleWidget .monitor-status.stream-off {
    color: $theme-foreground-muted;
}
ShellConsoleWidget #console-title {
    text-style: bold;
    color: $theme-primary;
}
ShellConsoleWidget #console-output.console-error-output {
    color: $theme-error;
}
IntelliSenseCompletionWidget .completion-detail {
    color: $theme-foreground-muted;
    text-style: dim;
}
IntelliSenseCompletionWidget .completion-kind {
    color: $theme-foreground-muted;
    text-style: dim;
}
FileManagerScreen .quick-action-item {
    color: $theme-foreground;
}
FileManagerScreen .quick-action-item .shortcut {
    color: $theme-primary;
    text-style: bold;
}
Footer {
    background: $theme-background-secondary;
    color: $theme-foreground;
}
FooterKey {
    text-style: none;
    background: $theme-background-secondary;
    color: $theme-foreground;
}
FooterKey > .footer-key--key {
    color: $theme-primary;
    background: $theme-background-secondary;
    text-style: bold;
}
FooterKey > .footer-key--description {
    padding: 0 1 0 0;
    color: $theme-foreground-muted;
    background: $theme-background-secondary;
}
FooterKey:hover {
    background: $theme-surface-hover;
}
FooterKey:hover > .footer-key--key {
    background: $theme-surface-hover;
}
.-hidden {
    display: none;
}
.panel-header {
    text-align: center;
    color: $theme-primary;
    text-style: bold;
    padding-bottom: 1;
    border-bottom: solid $theme-border;
}
Screen.-compact #main_grid {
    grid-columns: 30% 1fr 0;
}
Screen.-compact CodeAnalysisPanel,
Screen.-compact EventStreamPanel {
    display: none;
}
Screen.-minimal #main_grid {
    grid-columns: 0 1fr 0;
}
Screen.-minimal AuraStatusSidebar {
    display: none;
}
Screen.-compact ImaginationPanel {
    grid-columns: 100% 0;
}
Screen.-compact ImaginationPanel > .imag-right-pane {
    display: none;
}
Screen.-minimal ImaginationPanel {
    grid-rows: auto 1fr 0;
}
Screen.-minimal ImaginationPanel > .imag-footer {
    display: none;
}
TextArea {
    background: $theme-surface;
    border: round $theme-border;
}
TextArea:focus {
    border: round $theme-primary;
}
TextArea > .text-area--cursor {
    color: white;
    background: $theme-foreground;
}
RichLog {
    background: $theme-surface;
    scrollbar-gutter: stable;
}
RichLog:focus {
    border: round $theme-primary;
}
LoadingIndicator {
    background: $theme-surface;
    color: $theme-primary;
}
Placeholder {
    background: $theme-background-secondary;
    color: $theme-foreground-muted;
    border: dashed $theme-border;
}
Markdown {
    background: transparent;
    padding: 0 1;
}
Markdown .code_inline {
    background: $theme-background-tertiary;
    color: $theme-error;
}
MarkdownFence {
    background: $theme-background-secondary;
    border: round $theme-border;
    padding: 1;
    margin: 1 0;
}
MarkdownH1 {
    color: $theme-foreground;
    text-style: bold;
    border-bottom: solid $theme-border;
    padding-bottom: 1;
    margin: 1 0;
}
MarkdownH2 {
    color: $theme-foreground;
    text-style: bold;
    margin: 1 0;
}
MarkdownH3 {
    color: $theme-foreground-muted;
    text-style: bold;
    margin: 1 0;
}
MarkdownBlockQuote {
    border-left: wide $theme-primary;
    padding-left: 1;
    color: $theme-foreground-muted;
    background: $theme-background-secondary;
}
MarkdownBulletList, MarkdownOrderedList {
    margin: 0 0 0 2;
}
WorkflowMonitor {
    width: 100%;
    height: 100%;
    layout: grid;
    grid-size: 2 1;
    grid-columns: 35% 1fr;
}
WorkflowMonitor .workflow-list-pane {
    height: 100%;
    border-right: solid $theme-border;
    padding: 1;
}
WorkflowMonitor .workflow-detail-pane {
    height: 100%;
    padding: 1;
}
WorkflowMonitor .pane-header {
    color: $theme-primary;
    text-style: bold;
    padding-bottom: 1;
    border-bottom: solid $theme-border;
    margin-bottom: 1;
}
WorkflowMonitor .workflow-table {
    height: 40%;
}
WorkflowMonitor .step-tree {
    height: 50%;
    border-top: solid $theme-border;
    margin-top: 1;
    padding-top: 1;
}
WorkflowMonitor .detail-header {
    height: auto;
    padding: 1;
    background: $theme-surface;
    border: round $theme-border;
    margin-bottom: 1;
}
WorkflowMonitor .progress-section {
    height: 3;
    margin-bottom: 1;
}
WorkflowMonitor .output-log {
    height: 1fr;
    background: $theme-background-secondary;
    border: round $theme-border;
    padding: 1;
}
WorkflowMonitor .log-entry {
    margin-bottom: 1;
}
WorkflowMonitor .log-start {
    color: $theme-primary;
    text-style: bold;
}
WorkflowMonitor .log-success {
    color: $theme-success;
}
WorkflowMonitor .log-error {
    color: $theme-error;
    text-style: bold;
}
WorkflowMonitor .log-warning {
    color: $theme-warning;
}
WorkflowMonitor .log-info {
    color: $theme-foreground-muted;
    text-style: dim;
}
WorkflowMonitor .action-bar {
    height: 3;
    margin-top: 1;
    align: center middle;
}
WorkflowMonitor .sparkline-container {
    height: 3;
    margin: 1 0;
}
.completion-item {
    padding: 0 1;
}
.completion-item:hover {
    background: $theme-primary 20%;
}
.completion-hint {
    height: 1;
    color: $theme-foreground-muted;
    padding: 0 1;
}
MonitorHeader {
    width: 100%;
    height: 3;
    background: $theme-surface;
    padding: 0 1;
}
MonitorHeader .nav-btn {
    width: 3;
    min-width: 3;
    margin: 0;
    padding: 0;
}
MonitorHeader .url-input {
    width: 1fr;
    margin: 0 1;
}
MonitorHeader .status-icon {
    width: 3;
    content-align: center middle;
}
MonitorContent {
    width: 100%;
    height: 1fr;
    background: $theme-background;
    padding: 1;
}
MonitorContent .content-display {
    width: 100%;
}
MonitorFooter {
    width: 100%;
    height: 1;
    background: $theme-primary;
    color: white;
    padding: 0 1;
}
MonitorFooter .status-text {
    text-style: bold;
}
MonitorFooter .separator {
    color: white 60%;
    margin: 0 1;
}
MonitorFooter .key {
    color: white;
    text-style: bold;
}
MonitorFooter .action {
    color: white 80%;
    text-style: dim;
}
MonitorWidget {
    width: 100%;
    height: 100%;
    background: $theme-background;
    border: round $theme-primary;
}
MonitorWidget > Vertical {
    width: 100%;
    height: 100%;
}
MonitorCompact {
    width: 100%;
    height: auto;
    min-height: 5;
    padding: 1;
    border: round $theme-primary;
}
MonitorCompact .monitor-header {
    color: $theme-primary;
    text-style: bold;
    margin-bottom: 1;
}
MonitorCompact .monitor-status {
    margin: 0 1;
}
MonitorCompact .status-idle {
    color: $theme-foreground-muted;
    text-style: dim;
}
MonitorCompact .status-loading {
    color: $theme-warning;
    text-style: bold;
}
MonitorCompact .status-ok {
    color: $theme-success;
}
MonitorCompact .status-error {
    color: $theme-error;
    text-style: bold;
}
MonitorCompact .monitor-url {
    color: $theme-foreground-muted;
    text-style: dim;
    margin-top: 1;
}
MonitorCompact .monitor-preview {
    color: $theme-foreground-muted;
    text-style: italic dim;
    margin-top: 1;
}
TabBar Button {
    min-width: auto;
    height: 1;
    margin-right: 0;
    padding: 0 1;
}
ContentViewer .content-area {
    width: 100%;
}
MonitorScreen > Vertical {
    width: 100%;
    height: 100%;
}
.unavailable-message {
    width: 100%;
    height: 100%;
    content-align: center middle;
    background: $theme-background;
}
.unavailable-message Static {
    text-align: center;
}
LoadingSpinner {
    width: auto;
    height: 1;
}
LoadingSpinner > Horizontal {
    width: auto;
    height: 100%;
}
LoadingSpinner .spinner-frame {
    width: 2;
    color: $theme-primary;
}
LoadingSpinner .spinner-message {
    padding-left: 1;
    color: $theme-foreground-muted;
}
ProgressIndicator {
    width: 100%;
    height: auto;
}
ProgressIndicator .progress-label {
    padding-bottom: 1;
}
ProgressIndicator ProgressBar {
    width: 100%;
}
ProgressIndicator .progress-status {
    padding-top: 1;
    color: $theme-foreground-muted;
    text-align: center;
}
PulseAnimation {
    width: auto;
    height: 1;
}
PulseAnimation .pulse-text {
    color: $theme-primary;
}
PulseAnimation .pulse-dim {
    color: $theme-foreground-muted;
}
StatusBar {
    width: 100%;
    height: 1;
    background: $theme-surface;
    color: $theme-foreground-muted;
}
StatusBar > Horizontal {
    width: 100%;
    height: 100%;
}
StatusBar .status-item {
    padding: 0 1;
}
StatusBar .status-item-left {
    content-align: left middle;
}
StatusBar .status-item-right {
    content-align: right middle;
}
StatusBar .status-spacer {
    width: 1fr;
}
MiniStatusBar {
    width: 100%;
    height: 1;
    background: $theme-surface;
    color: $theme-foreground-muted;
    padding: 0 1;
}
MiniStatusBar .mini-status-icon {
    width: auto;
}
MiniStatusBar .mini-status-text {
    width: 1fr;
}
MiniStatusBar .mini-status-extra {
    width: auto;
    color: $theme-foreground-muted;
}
CollapsiblePanel {
    width: 100%;
    height: auto;
    background: $theme-surface;
    border: solid $theme-primary;
}
CollapsiblePanel .panel-header {
    width: 100%;
    height: 3;
    background: $theme-surface;
    border-bottom: solid $theme-primary;
}
CollapsiblePanel .panel-toggle {
    width: 3;
    min-width: 3;
    padding: 0;
    background: transparent;
    border: none;
}
CollapsiblePanel .panel-title {
    width: 1fr;
    padding: 0 1;
    text-style: bold;
}
CollapsiblePanel .panel-content {
    width: 100%;
    height: auto;
    padding: 1;
}
CollapsiblePanel .panel-content-collapsed {
    display: none;
}
CollapsiblePanel .panel-collapsed .panel-header {
    border-bottom: none;
}
SplitPanel {
    width: 100%;
    height: 100%;
}
SplitPanel > Horizontal,
SplitPanel > Vertical {
    width: 100%;
    height: 100%;
}
SplitPanel .split-pane {
    overflow: auto;
}
SplitPanel .split-pane-first {
    width: 1fr;
    height: 1fr;
}
SplitPanel .split-pane-second {
    width: 2fr;
    height: 2fr;
}
SplitPanel .split-divider {
    background: $theme-primary;
}
SplitPanel .split-divider-horizontal {
    width: 1;
    height: 100%;
}
SplitPanel .split-divider-vertical {
    width: 100%;
    height: 1;
}
SplitPanel .split-divider:hover {
    background: $theme-primary;
}
Toast.toast-info {
    border: solid $theme-primary;
}
Toast.toast-success {
    border: solid $theme-success;
}
Toast.toast-warning {
    border: solid $theme-warning;
}
Toast.toast-error {
    border: solid $theme-error;
}
Toast .toast-header {
    width: 100%;
    height: 1;
}
Toast .toast-icon {
    width: 3;
}
Toast .toast-title {
    width: 1fr;
    text-style: bold;
}
Toast .toast-close {
    width: 3;
    min-width: 3;
    padding: 0;
    background: transparent;
    border: none;
}
Toast .toast-message {
    padding-top: 1;
}
Toast .toast-action {
    margin-top: 1;
}
NotificationCenter {
    dock: right;
    width: auto;
    height: 100%;
    layer: notification;
}
NotificationCenter > Vertical {
    width: auto;
    height: auto;
    align: right top;
    padding: 1;
}
KeyValueTable {
    width: 100%;
    height: auto;
}
KeyValueTable DataTable {
    width: 100%;
    height: auto;
}
TreeView {
    width: 100%;
    height: 100%;
}
TreeView Tree {
    width: 100%;
    height: 100%;
}
Breadcrumb {
    width: 100%;
    height: 1;
    background: $theme-surface;
}
Breadcrumb > Horizontal {
    width: 100%;
    height: 100%;
}
Breadcrumb .breadcrumb-item {
    padding: 0 1;
    color: $theme-primary;
}
Breadcrumb .breadcrumb-item:hover {
    background: $theme-primary 20%;
    color: $theme-foreground;
}
Breadcrumb .breadcrumb-separator {
    padding: 0;
    color: $theme-foreground-muted;
}
Breadcrumb .breadcrumb-current {
    color: $theme-foreground;
    text-style: bold;
}
TabBar > Horizontal {
    width: 100%;
    height: 100%;
}
TabBar .tab {
    padding: 0 1;
    height: 1;
    background: $theme-surface;
    border: none;
}
TabBar .tab:hover {
    background: $theme-surface-hover;
}
TabBar .tab-active {
    background: $theme-primary;
    color: white;
    text-style: bold;
    border: none;
}
TabBar .tab-close {
    width: 2;
    min-width: 2;
    height: 1;
    padding: 0;
    background: transparent;
    border: none;
}
TabBar .tab-close:hover {
    color: $theme-error;
}
TabBar .tab-spacer {
    width: 1fr;
}
BaseDialog > Container {
    width: auto;
    max-width: 80%;
    height: auto;
    max-height: 80%;
    background: $theme-surface;
    border: round $theme-border;
    padding: 1 2;
}
BaseDialog .dialog-title {
    text-style: bold;
    color: $theme-foreground;
    padding-bottom: 1;
    border-bottom: solid $theme-border;
    margin-bottom: 1;
}
BaseDialog .dialog-content {
    padding: 1 0;
}
BaseDialog .dialog-buttons {
    padding-top: 1;
    border-top: solid $theme-border;
    margin-top: 1;
    align: center middle;
}
BaseDialog Button {
    margin: 0 1;
}
InputDialog Input {
    width: 100%;
    margin: 1 0;
}
SelectDialog Select {
    width: 100%;
    margin: 1 0;
}
ProgressDialog ProgressBar {
    width: 100%;
    margin: 1 0;
}
.tree-header {
    color: $theme-primary;
    text-style: bold;
    padding: 1;
    border-bottom: solid $theme-border;
}
.tree-filter {
    padding: 0 1;
    margin-bottom: 1;
}
.file-tree {
    height: 1fr;
    padding: 0 1;
}
IssuesPanel {
    width: 100%;
    height: 100%;
    padding: 0;
}
.issues-header {
    height: 3;
    padding: 1;
    border-bottom: solid $theme-border;
}
.issues-summary {
    color: $theme-foreground-muted;
}
.issues-table {
    height: 1fr;
}
